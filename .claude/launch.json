      "port": 5174
    },
    {
      "name": "web-live",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "process.env.META_MODEL_ENABLED='true';process.env.META_VOICE_ENABLED='true';require('node:child_process').spawn(process.execPath,['node_modules/vite/bin/vite.js','--port','5175','--strictPort'],{stdio:'inherit',env:process.env}).on('exit',(c)=>process.exit(c??0))"
