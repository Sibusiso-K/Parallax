{
  "name": "parallax",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "stress": "vitest run stress",
    "eval": "node --import ./evals/register.mjs evals/run.ts",
    "preview": "vite preview",
    "eval:live": "vitest run --config vitest.live.config.ts",
    "eval:summary": "node evals/summarise.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "smoke": "node scripts/smoke.mjs",
    "lint": "oxlint -c .oxlintrc.json api shared web/src evals scripts vite.config.ts vitest.live.config.ts"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "oxlint": "^1.92.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
